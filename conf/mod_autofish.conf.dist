[worldserver]

########################################
# mod-autofish
########################################

#    AutoFish.Enable
#        Turn the module on or off.
#        Default: 1

AutoFish.Enable = 1

#    AutoFish.StartOnCast
#        1 = casting Fishing by hand starts auto-fishing automatically.
#        0 = only ".autofish on" starts it.
#        Default: 1

AutoFish.StartOnCast = 1

#    AutoFish.MinSecurity
#        Lowest account level allowed to use it.
#        0 = everyone, 1 = moderator, 2 = GM, 3 = admin.
#        Default: 0

AutoFish.MinSecurity = 0

#    AutoFish.ReactionMinMs / AutoFish.ReactionMaxMs
#        Random delay between the splash and the hook (ms).
#        The bobber is only hookable for ~5 seconds, so the max is capped at 4000.
#        Default: 400 / 1200

AutoFish.ReactionMinMs = 400
AutoFish.ReactionMaxMs = 1200

#    AutoFish.RecastMinMs / AutoFish.RecastMaxMs
#        Random delay between looting and the next cast (ms).
#        Default: 800 / 1800

AutoFish.RecastMinMs = 800
AutoFish.RecastMaxMs = 1800

#    AutoFish.AutoLure
#        Re-apply the best lure in your bags when the pole has none.
#        Default: 1

AutoFish.AutoLure = 1

#    AutoFish.AutoOpenClams
#        Open clams and crates you fish up (requires 2+ free bag slots).
#        Default: 1

AutoFish.AutoOpenClams = 1

#    AutoFish.StopOnMove
#        Stop when you move or turn. Recommended - it's your off switch.
#        Default: 1

AutoFish.StopOnMove = 1

#    AutoFish.StopOnCombat
#        Stop when you enter combat.
#        Default: 1

AutoFish.StopOnCombat = 1

#    AutoFish.MaxMinutes
#        Stop after this many minutes. 0 = no limit.
#        Default: 0

AutoFish.MaxMinutes = 0

#    AutoFish.MinFreeBagSlots
#        Stop when you have fewer free bag slots than this.
#        Default: 1

AutoFish.MinFreeBagSlots = 1

#    AutoFish.AnnounceCatches
#        Print each catch to your chat.
#        Default: 0

AutoFish.AnnounceCatches = 0
